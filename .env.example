# Neravu Environment Configuration
PORT=3000
NODE_ENV=development

# Authoritative Supabase / PostgreSQL Connection
# Mandatory in production. Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Cryptographic HMAC Authentication Session Secret
# Mandatory in production (minimum 32 characters)
AUTH_SESSION_SECRET=

# Production Allowed Origins (Comma-separated list for cross-origin deployments)
# Leave empty for standard unified same-origin deployment. Example: https://app.neravu.in,https://admin.neravu.in
ALLOWED_ORIGINS=

# Production SMS Provider Gateway (Mandatory in production for live SMS delivery)
# Example: https://api.sms-gateway.com/v1/send-otp
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_NAME=ProductionSmsGateway

# Google Maps Platform API Key (Frontend-safe, HTTP-referrer restricted in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=
